{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "nodenext",
    "target": "es2020",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "nodenext",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": ["DOM", "ES5", "ES6", "ES7", "es2019", "es2020"]
  },
  "include": ["**/*.ts"]
}
